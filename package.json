{
  "name": "noeul",
  "version": "1.0.0",
  "description": "A free desktop music player with search, streaming and downloads",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --build --force"
  },
  "keywords": ["music", "youtube-music", "electron", "desktop", "player"],
  "author": "deep095",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deep095/noeul.git"
  },
  "homepage": "https://github.com/deep095/noeul",
  "bugs": {
    "url": "https://github.com/deep095/noeul/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@biomejs/biome@1.8.3": true,
    "ffmpeg-static@5.3.0": true
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.33.0",
    "node-id3": "^0.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yt-dlp-wrap-plus": "^2.5.0",
    "ytmusic-api": "^5.3.1"
  },
  "build": {
    "appId": "com.noeul.app",
    "productName": "Noeul",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      { "from": "assets/icon.png", "to": "icon.png" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Noeul"
    }
  }
}
